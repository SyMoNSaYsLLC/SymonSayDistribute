#
# symoneural-learn.env.example — the deployment's configuration contract, in one place.
#
# Copy to ~/.config/symoneural/learn.env (per user) or /etc/symoneural/learn.env (system)
# and source it before starting any unit:   set -a; . ~/.config/symoneural/learn.env; set +a
#
# Every SYM_* variable the product reads is declared here with the default the code uses
# when the variable is unset. Precedence: process environment > this file > default in code.
# A variable that appears in code and not here is a defect — the ship gate's repo scan lists
# undeclared SYM_* names.
#
# NO SECRETS IN THIS FILE, EVER. The gateway credential lives in the file named by
# SYM_GW_KEY_FILE (mode 0600, created by the operator, never committed). This file names
# where it is; it never holds it.

# ── Topology ─────────────────────────────────────────────────────────────────────────────
# Three loopback ports on one host. Loopback is the design, not a default: public reach is
# through the edge proxy and the tunnel, never by binding an interface.
SYM_GW_HOST=127.0.0.1                       # gateway bind address
SYM_GW_PORT=9001                            # the /v1 Messages-dialect gateway
SYM_CHAT_PORT=8802                          # the chat unit (the engine); serve-chat-unit.sh binds it
SYM_CHAT_URL=http://127.0.0.1:8802          # where the gateway forwards. THE ONE ADDRESS that changes
                                            # when the engine behind /v1 is swapped (rules §3.10)
SYM_CHAT_TOKEN=                             # the chat unit's OWN bearer, when the engine requires one (the estate's
                                            # runtime does; the substitution engine does not). A secret: set it in the
                                            # process environment from a 0600 file, never written into a tracked file
SYM_CHAT_WORKER_MODEL=                      # the model id the engine answers to. Empty: each card's own worker_model
                                            # (symon-ai). The estate-built engine names its model `default` → set it here
SYM_GW_URL=http://127.0.0.1:9001            # what the web UI proxies /gw/* to and probes
SYM_API_URL=http://127.0.0.1:8800           # the control plane the web UI probes (/ctl/*). R14: read-only
# The web UI uses Next.js' own names for its bind: PORT=8812 HOSTNAME=127.0.0.1

# ── Gateway (gateway/symoneural_gateway) ─────────────────────────────────────────────────
SYM_GW_KEY_FILE=~/.config/symoneural/gateway-9001.key   # 0600. Re-read per request: rotation = replace the file
SYM_GW_CONNECT_TIMEOUT=2.0                  # seconds to reach the chat unit; fail fast when it is down
SYM_GW_READ_TIMEOUT=900                     # seconds for one response; local prefill on one card can be slow
SYM_LOG_LEVEL=info

# ── Chat unit (runtime/serve-chat-unit.sh, runtime/bringup-chat-unit.sh) ─────────────────
# This is the recorded substitution (rules §3.10): an acquired engine run from a host venv,
# until the estate's own engine replaces it. Nothing here may be reported as symoneural-llm.
SYM_CHAT_ENGINE_VENV=~/.venvs/vllm-0271-cu130
SYM_MODELS_DIR=~/symoneural-models          # weights live OUTSIDE the repository, always
SYM_CHAT_MODEL_DIR=${SYM_MODELS_DIR}/symon-chat   # the checkpoint directory, under our name; provenance in the estate's model register
SYM_CHAT_SERVED_NAME=symon-ai               # the engine-side name; the gateway maps it to symon-sonnet / symon-opus / symon-fable
SYM_MAX_MODEL_LEN=16384                     # served context. Must agree with the gateway's model cards;
                                            # GET /version re-reads the live value so drift is reported
SYM_MAX_SEQS=4
SYM_GPU_FRACTION=0.90                       # MEASURED working on a 16 GB card (compute capability 12.0): 0.917 with the two below
SYM_CPU_OFFLOAD_GB=                         # empty = none. 3 was needed for the 20B MXFP4 checkpoint on 16 GB
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True   # fixes the allocator fragmentation OOM in expert repacking
SYM_BRINGUP_GRACE=120                       # seconds before the bring-up ladder judges a rung dead —
                                            # the engine prints --version first and nothing is listening yet
SYM_RUN_DIR=~/symoneural-run                # pids, logs, ladder records

# ── The estate's own chat runtime (symoneural-llm over libsymoneural-llm; the §3.10 target) ──
SYM_LLM_REGISTRY_ROOT=~/symoneural-models/registry   # directory of <id>.gguf; the id is the model name the gateway sends
SYM_LLM_GPU_LAYERS=0                        # 0 CPU only (default), -1 every layer on the GPU backend, N the first N
SYM_LLM_ALLOWED_MODELS=                     # comma-separated ids to serve; empty = every gguf in the registry
SYM_LLM_PROMPT_STYLE=channels               # transcript (the documented plain format) | channels (checkpoints trained
                                            # to reason in one channel and answer in another — the 20B MXFP4 checkpoint)
SYM_LLM_REASONING=medium                    # the checkpoint's reasoning level: low | medium | high
SYM_LLM_IDENTITY=                           # the assistant's identity line in the system message; empty = the runtime's default
